{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Sinaxa: Run",
      "type": "shell",
      "command": "python3",
      "args": [
        "-m", "src.server",
        "--port", "8789",
        "--state", "${workspaceFolder}/state",
        "--cwd", "${workspaceFolder}"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": {
        "owner": "sinaxa",
        "pattern": { "regexp": "^(.*)$", "message": 1 },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^sinaxa ->",
          "endsPattern": "^sinaxa ->"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "runOptions": { "instanceLimit": 1 }
    },
    {
      "label": "Sinaxa: Test",
      "type": "shell",
      "command": "pytest",
      "args": ["-q"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "test", "isDefault": true },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    }
  ]
}
